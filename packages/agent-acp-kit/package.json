{
  "name": "@tutti-os/agent-acp-kit",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "Workspace wrapper for @tutti-os/agent-acp-kit with Tutti agent provider catalog helpers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
