{
  "schemaVersion": "tutti.app.cli.v1",
  "scope": "sheet",
  "description": "Open, import, and inspect AI Sheet workbook projects.",
  "documentation": {
    "file": "COMMANDS.md"
  },
  "commands": [
    {
      "path": [
        "status"
      ],
      "summary": "Show AI Sheet status",
      "description": "Return app health, project counts, Agent Target counts, and Tutti CLI availability for AI Sheet.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/status",
        "timeoutMs": 10000
      }
    },
    {
      "path": [
        "projects",
        "list"
      ],
      "summary": "List workbook projects",
      "description": "List recent workbook projects as JSON for agents and other Tutti apps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum number of projects to return."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/projects/list",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "projects",
        "get"
      ],
      "summary": "Get a workbook project",
      "description": "Return one workbook project by project-id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id to load."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/projects/get",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "projects",
        "open"
      ],
      "summary": "Open a workbook project",
      "description": "Explicitly request Tutti to open one workbook project in AI Sheet. Use this only after the user confirms they want you to open the app directly; create, import, and agent-edit commands must not call it automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Workbook project id to open."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/projects/open",
        "timeoutMs": 10000
      }
    },
    {
      "path": [
        "projects",
        "create"
      ],
      "summary": "Create a workbook project",
      "description": "Create a new AI Sheet workbook project, return an internal openTarget command, and optionally start app-owned async editing with prompt. This command must not open the app automatically. Do not present localhost URLs or raw routes as final links. When the task is complete, tell the user they can view the result in AI Sheet and ask whether they want you to open it directly; if they confirm, call sheet projects open with the project-id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Project title."
          },
          "prompt": {
            "type": "string",
            "description": "Optional prompt for the AI Sheet app agent to initialize or edit the workbook after project creation."
          },
          "agent-id": {
            "type": "string",
            "description": "Optional exact Agent Target id for AI Sheet. Discover current targets with `tutti agent list --json`. If omitted, the current default available Agent Target is used."
          },
          "provider": {
            "type": "string",
            "description": "Deprecated provider compatibility input. It succeeds only when the provider maps to exactly one Agent Target in the full current catalog; otherwise use agent-id."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/projects/create",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "workbook",
        "get"
      ],
      "summary": "Get workbook context",
      "description": "Return one workbook project's current XLSX manifest and local workspace context. XLSX content is returned as a focused local file path instead of inline workbook data. To modify workbook content through CLI, start an app-owned edit with sheet agent edit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Workbook project id to inspect."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/workbook/get",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "workspace",
        "get"
      ],
      "summary": "Get workbook workspace",
      "description": "Return local workspace paths, focused artifact paths, assets, exports, and guidance for one workbook project in AI Sheet. Local paths are for inspection; content modifications through CLI must trigger the app-owned agent run.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Workbook project id to inspect."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/workspace/get",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "exports",
        "list"
      ],
      "summary": "List workbook exports",
      "description": "List files already exported from one workbook project, including local paths, MIME types, sizes, and modification times.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Workbook project id whose exports should be listed."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/exports/list",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "sessions",
        "list"
      ],
      "summary": "List conversation sessions",
      "description": "List agent conversation sessions for a workbook project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id whose sessions should be listed."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/sessions/list",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "sessions",
        "create"
      ],
      "summary": "Create a conversation session",
      "description": "Create a new agent conversation session for a workbook project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id for the new session."
          },
          "title": {
            "type": "string",
            "description": "Optional session title."
          }
        },
        "required": [
          "project-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/sessions/create",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "messages",
        "list"
      ],
      "summary": "List conversation messages",
      "description": "List messages in one agent conversation session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id that owns the session."
          },
          "session-id": {
            "type": "string",
            "description": "Conversation session id."
          }
        },
        "required": [
          "project-id",
          "session-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/messages/list",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "messages",
        "create"
      ],
      "summary": "Create a conversation message",
      "description": "Append a text-only user or assistant message to one conversation session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id that owns the session."
          },
          "session-id": {
            "type": "string",
            "description": "Conversation session id."
          },
          "role": {
            "type": "string",
            "description": "Message role: user or assistant."
          },
          "content": {
            "type": "string",
            "description": "Message text content."
          }
        },
        "required": [
          "project-id",
          "session-id",
          "role",
          "content"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/messages/create",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "agent",
        "edit"
      ],
      "summary": "Ask the app agent to edit content",
      "description": "Start an app-owned agent edit for a workbook project and return an internal openTarget command. External agents and other Tutti apps must use this command to modify workbook content, then poll agent events until the run reaches a terminal status. This command must not open the app automatically. After completion, tell the user they can view the result in AI Sheet and ask whether they want you to open it directly; if they confirm, call sheet projects open.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project-id": {
            "type": "string",
            "description": "Project id to edit."
          },
          "prompt": {
            "type": "string",
            "description": "User prompt for the app-owned agent."
          },
          "session-id": {
            "type": "string",
            "description": "Optional conversation session id."
          },
          "mode": {
            "type": "string",
            "description": "Optional edit mode: write or rewrite."
          },
          "agent-id": {
            "type": "string",
            "description": "Optional exact Agent Target id for AI Sheet. Discover current targets with `tutti agent list --json`. If omitted, the current default available Agent Target is used."
          },
          "provider": {
            "type": "string",
            "description": "Deprecated provider compatibility input. It succeeds only when the provider maps to exactly one Agent Target in the full current catalog; otherwise use agent-id."
          }
        },
        "required": [
          "project-id",
          "prompt"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/agent/edit",
        "timeoutMs": 60000
      }
    },
    {
      "path": [
        "agent",
        "events"
      ],
      "summary": "Poll agent events",
      "description": "Return one agent run, its persisted events, and the internal project openTarget command by run-id. When the run reaches completed, ask whether the user wants you to open the project directly; if they confirm, call sheet projects open.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run-id": {
            "type": "string",
            "description": "Agent run id."
          }
        },
        "required": [
          "run-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/agent/events",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "agent",
        "cancel"
      ],
      "summary": "Cancel an agent run",
      "description": "Cancel an active agent run by run-id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run-id": {
            "type": "string",
            "description": "Agent run id."
          }
        },
        "required": [
          "run-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/agent/cancel",
        "timeoutMs": 30000
      }
    },
    {
      "path": [
        "officecli",
        "install"
      ],
      "summary": "Install OfficeCLI",
      "description": "Install or repair the managed OfficeCLI toolchain used for XLSX import, export, and agent editing.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/officecli/install",
        "timeoutMs": 120000
      }
    },
    {
      "path": [
        "open"
      ],
      "summary": "Open a workbook file",
      "description": "Import an XLSX file into AI Sheet and return workspace paths plus an internal openTarget command for the imported project. This command must not open the app automatically. Do not present localhost URLs or raw routes as final links. Ask whether the user wants you to open the project directly; if they confirm, call sheet projects open with the project-id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute local path to the import file. Relative and home-relative paths are not accepted; upload file content when no absolute path is available."
          },
          "title": {
            "type": "string",
            "description": "Optional project title override."
          }
        },
        "required": [
          "path"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/open",
        "timeoutMs": 30000
      }
    }
  ]
}
