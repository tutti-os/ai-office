{
  "name": "@ai-slide/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-slide/server --filter @ai-slide/web dev",
    "dev:web": "pnpm --filter @ai-slide/web dev",
    "dev:server": "pnpm --filter @ai-slide/server dev",
    "build": "pnpm --filter @ai-slide/shared build && pnpm --filter @ai-slide/web build && pnpm --filter @ai-slide/server build",
    "check": "pnpm --filter @ai-slide/shared check && pnpm --filter @ai-slide/web check && pnpm --filter @ai-slide/server check",
    "check:i18n": "node ../../scripts/check-doc-i18n.mjs",
    "package:tutti": "pnpm --filter @tutti-os/agent-acp-kit build && node ../../scripts/patch-agent-acp-kit-base.mjs && node ../../tooling/tutti/package-slide-tutti-app.mjs",
    "sync:templates": "node scripts/sync-slide-templates.mjs",
    "publish:office-templates": "node scripts/publish-office-templates.mjs"
  }
}
