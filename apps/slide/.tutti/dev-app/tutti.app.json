{
  "schemaVersion": "tutti.app.manifest.v1",
  "appId": "ai-ppt",
  "version": "0.1.0",
  "name": "AI PPT",
  "description": "Human and local agents editing presentation decks together.",
  "icon": {
    "type": "asset",
    "src": "icon.svg"
  },
  "runtime": {
    "bootstrap": "bootstrap.sh",
    "healthcheckPath": "/api/health",
    "profile": "node-static"
  },
  "hostCompatibility": {
    "requiredTuttiCapabilities": ["managed-model-cli-v1"]
  },
  "cli": {
    "manifest": "tutti.cli.json"
  },
  "references": {
    "listEndpoint": "/tutti/references/list",
    "searchEndpoint": "/tutti/references/search"
  },
  "window": {
    "minimizeBehavior": "keep-mounted",
    "minWidth": 1120,
    "minHeight": 720
  },
  "localizationInfo": {
    "defaultLocale": "en",
    "additionalLocales": [
      {
        "locale": "zh-CN",
        "file": "locales/zh-CN/manifest.json"
      }
    ]
  },
  "author": {
    "name": "Tutti"
  },
  "tags": ["local-first", "agent", "slide", "deck", "editor"]
}
