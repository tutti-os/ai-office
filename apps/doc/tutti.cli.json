{
  "schemaVersion": "tutti.app.cli.v1",
  "scope": "doc",
  "description": "Create and inspect AI Doc projects.",
  "documentation": {
    "file": "COMMANDS.md"
  },
  "commands": [
    {
      "path": ["status"],
      "summary": "Show AI Doc status",
      "description": "Return app health, project counts, runtime provider counts, and Tutti CLI availability.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/status",
        "timeoutMs": 10000
      }
    },
    {
      "path": ["list-projects"],
      "summary": "List document projects",
      "description": "List recent AI Doc projects as a table for agents and other Tutti apps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum number of projects to return."
          }
        }
      },
      "output": {
        "defaultMode": "table",
        "json": true,
        "table": {
          "columns": [
            { "key": "title", "label": "Title" },
            { "key": "type", "label": "Type" },
            { "key": "updated-at", "label": "Updated" }
          ]
        }
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/list-projects",
        "timeoutMs": 10000
      }
    },
    {
      "path": ["create"],
      "summary": "Create a document project",
      "description": "Create a new HTML or Markdown document project from title and content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Project title."
          },
          "type": {
            "type": "string",
            "description": "Document type: html or markdown."
          },
          "content": {
            "type": "string",
            "description": "Initial document content."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/create",
        "timeoutMs": 30000
      }
    }
  ]
}
