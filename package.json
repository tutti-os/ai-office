{
  "name": "ai-artifact-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:doc",
    "dev:doc": "pnpm --filter @ai-doc/app dev",
    "dev:doc:web": "pnpm --filter @ai-doc/web dev",
    "dev:doc:server": "pnpm --filter @ai-doc/server dev",
    "dev:slide": "pnpm --filter @ai-slide/app dev",
    "dev:sheet": "pnpm --filter @ai-sheet/app dev",
    "dev:sheet:web": "pnpm --filter @ai-sheet/web dev",
    "dev:sheet:server": "pnpm --filter @ai-sheet/server dev",
    "build": "pnpm -r --filter \"./packages/*\" --if-present build && pnpm --filter @ai-doc/app build && pnpm --filter @ai-slide/app build && pnpm --filter @ai-sheet/app build",
    "check": "pnpm check:css-layering && pnpm check:agent-detection && pnpm check:parity && pnpm check:file-size && pnpm check:import-boundaries && pnpm -r --filter \"./packages/*\" --if-present check && pnpm --filter @ai-doc/app check && pnpm --filter @ai-slide/app check && pnpm --filter @ai-sheet/app check",
    "check:css-layering": "node scripts/check-css-layering.mjs",
    "check:agent-detection": "node --experimental-strip-types scripts/check-agent-runtime-detection.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:i18n": "node scripts/check-doc-i18n.mjs",
    "check:import-boundaries": "node scripts/check-import-boundaries.mjs",
    "check:parity": "node scripts/check-artifact-app-parity.mjs",
    "generate:cli-manifests": "node tooling/tutti/generate-cli-manifests.mjs",
    "validate:tutti": "node scripts/validate-tutti-app-package.mjs build/tutti-app/package",
    "validate:doc-tutti": "node scripts/validate-tutti-app-package.mjs build/tutti-app/package ai-doc doc",
    "validate:slide-tutti": "node scripts/validate-tutti-app-package.mjs build/tutti-slide-app/package ai-slide slide",
    "validate:sheet-tutti": "node scripts/validate-tutti-app-package.mjs build/tutti-sheet-app/package ai-sheet sheet",
    "package:tutti": "pnpm --filter @ai-doc/app package:tutti",
    "package:doc-tutti": "pnpm --filter @ai-doc/app package:tutti",
    "package:slide-tutti": "pnpm --filter @ai-slide/app package:tutti",
    "package:sheet-tutti": "pnpm --filter @ai-sheet/app package:tutti"
  },
  "devDependencies": {
    "@ai-app/tutti-packager": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.11.0"
}
